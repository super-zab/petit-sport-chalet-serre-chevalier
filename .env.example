# Copier ce fichier en .env.local pour le développement.
# En production, renseigner ces variables dans Vercel (Settings → Environment Variables).

# Adresse publique du site, sans barre finale.
NEXT_PUBLIC_BASE_URL=http://localhost:3000

# Base Postgres (Neon). Utiliser l'adresse « pooled » fournie par Neon.
# Laisser vide en local : une base embarquée de test est créée automatiquement.
DATABASE_URL=

# Jeton à saisir une seule fois sur /admin/installation pour créer le premier compte.
# Générer avec : openssl rand -hex 32
ADMIN_SETUP_TOKEN=

# Emails (https://resend.com). Sans clé, les emails sont seulement écrits dans les logs.
RESEND_API_KEY=
EMAIL_FROM="Le Petit Sport Chalet <reservation@votre-domaine.fr>"
# Destinataires des alertes « nouvelle demande », séparés par des virgules.
ADMIN_NOTIFICATION_EMAILS=

# Secret de la tâche planifiée Vercel. Générer avec : openssl rand -hex 32
CRON_SECRET=
